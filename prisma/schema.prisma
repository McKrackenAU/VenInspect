// VenInspect — bridge, drainage & noise wall inspections

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  INSPECTOR
}

enum InspectionStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

/// How this inspection relates to others (combine / parent-child)
enum InspectionRelationKind {
  STANDALONE
  PARENT
  CHILD
}

enum AuditAssignmentStatus {
  PLANNED
  ASSIGNED
  IN_PROGRESS
  DONE
  CANCELLED
}

/// Optional peer / second-opinion review after submit
enum ReviewStatus {
  NONE
  REQUESTED
  COMPLETED
  SKIPPED
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  /// Login name (e.g. root). Optional — email also works for login.
  username        String?  @unique
  name            String
  firstName       String?
  lastName        String?
  role            Role     @default(INSPECTOR)
  passwordHash    String?
  microsoftOid    String?  @unique
  /// May sign in with username/password (admin can disable e.g. SSO-only)
  allowPasswordLogin  Boolean  @default(true)
  /// May sign in with Microsoft Entra (admin can disable)
  allowMicrosoftLogin Boolean  @default(true)
  level1Qualified Boolean  @default(false)
  level2Qualified Boolean  @default(false)
  /// Professional / inspector registration number (shown on reports)
  registrationNumber String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inspectionsCreated  Inspection[]      @relation("InspectionCreator")
  inspectionsApproved Inspection[]      @relation("InspectionApprover")
  reviewsRequestedOf  Inspection[]      @relation("InspectionReviewTarget")
  inspectionsReviewed Inspection[]      @relation("InspectionReviewer")
  inspectionsDeleted  Inspection[]      @relation("InspectionDeletedBy")
  notifications       Notification[]
  documentsUploaded   AssetDocument[]   @relation("DocumentUploader")
  auditsAssigned      AuditAssignment[] @relation("AuditAssignee")
  auditsCreated       AuditAssignment[] @relation("AuditCreator")
  attributeSnapshots  AssetAttributeSnapshot[] @relation("SnapshotActor")
  passwordResetTokens PasswordResetToken[]
}

/// One-time password reset link (emailed to user)
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 hex of the raw token in the email link
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Asset {
  id                  String    @id @default(cuid())
  assetNumber         String    @unique
  assetVisionId       String?
  name                String
  /// Admin-managed catalogue code (e.g. BRIDGE, DRAINAGE, NOISE_WALL)
  type                String    @default("BRIDGE")
  /// Primary grouping key in registry & photo folders (e.g. Kororoit Creek Road)
  roadName            String    @default("Unknown Road")
  location            String?
  latitude            Float?
  longitude           Float?
  parentDirection     String?
  parentChainage      Float?
  /// Start chainage (m) along the parent road
  chainageFrom        Float?
  /// End chainage (m) along the parent road
  chainageTo          Float?
  parentAssetCode     String?
  parentAssetName     String?
  classification      String?
  /// Structural subclass e.g. PED_UNDERPASS under BRIDGE
  subClassification   String?
  notes               String?
  level1IntervalYears Int       @default(3)
  level2IntervalYears Int       @default(5)
  /// Manual baseline when history isn’t in VenInspect yet (bootstrap tracking)
  lastLevel1At        DateTime?
  lastLevel2At        DateTime?
  /// Site access / WHS flags — prompt on inspection start
  requireConfinedSpace      Boolean @default(false)
  requireTrafficManagement  Boolean @default(false)
  requireWorkingAtHeights   Boolean @default(false)
  /// Durable Asset Vision Attributes: { values, importedAt?, sourceFile? }
  profileJson         String?
  /// Structural components register: [{ id, name, category?, qty?, unit?, sortOrder }]
  componentsJson      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  inspections Inspection[]
  documents   AssetDocument[]
  assignments AuditAssignment[]
  attributeSnapshots AssetAttributeSnapshot[]

  @@index([roadName, assetNumber])
  @@index([assetVisionId])
  @@index([type])
}

model AssetDocument {
  id               String    @id @default(cuid())
  assetId          String
  title            String
  originalFilename String
  storagePath      String
  mimeType         String
  sizeBytes        Int
  /// JSON array of tag values from admin catalogue
  tagsJson         String    @default("[]")
  documentDate     DateTime?
  notes            String?
  uploadedById     String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  asset      Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([assetId])
}

model AuditAssignment {
  id            String                @id @default(cuid())
  assetId       String
  /// Inspection type code (LEVEL_1 / LEVEL_2 / …)
  level         String
  dueDate       DateTime
  assignedToId  String?
  createdById   String
  notes         String?
  status        AuditAssignmentStatus @default(PLANNED)
  inspectionId  String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  asset      Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("AuditAssignee", fields: [assignedToId], references: [id])
  createdBy  User  @relation("AuditCreator", fields: [createdById], references: [id])

  @@index([assignedToId, status, dueDate])
  @@index([assetId, dueDate])
  @@index([status, dueDate])
}

model Inspection {
  id                     String                 @id @default(cuid())
  assetId                String
  /// Inspection type code (e.g. LEVEL_1) — admin-editable list in settings
  level                  String
  status                 InspectionStatus       @default(DRAFT)
  inspectedAt            DateTime               @default(now())
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  /// First submit timestamp — set once when leaving DRAFT; not overwritten on edit/resubmit
  submittedAt            DateTime               @default(now())
  /// Bumped on form/defect edits (does not change submission or inspection date)
  lastEditedAt           DateTime?
  approvedAt             DateTime?
  generalComments        String?
  /// Template answers + UI state (open sections / optional pages) as JSON
  formPayload            String?
  /// When re-editing a submitted report: status to restore if user exits without saving
  editRestoreStatus      String?
  /// Snapshot at reopen (JSON: formPayload, generalComments) for cancel
  editSnapshot           String?
  createdById            String
  approvedById           String?
  requiresLevel2Approval Boolean                @default(false)

  /// Peer second-opinion: NONE | REQUESTED | COMPLETED | SKIPPED
  reviewStatus           ReviewStatus           @default(NONE)
  reviewRequestedFromId  String?
  reviewedById           String?
  reviewedAt             DateTime?
  /// Optional note when requesting a second look
  reviewNote             String?

  /// Photo folder segment: DDMMYYYY or DDMMYYYY-HHmmss
  folderKey              String
  /// Display: "Kororoit Creek Road - SN1234 - 19072026" (+ time if needed)
  titleLabel             String
  relationKind           InspectionRelationKind @default(STANDALONE)
  parentInspectionId     String?
  deletedAt              DateTime?
  deletedById            String?

  asset               Asset                 @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy           User                  @relation("InspectionCreator", fields: [createdById], references: [id])
  approvedBy          User?                 @relation("InspectionApprover", fields: [approvedById], references: [id])
  reviewRequestedFrom User?                 @relation("InspectionReviewTarget", fields: [reviewRequestedFromId], references: [id])
  reviewedBy          User?                 @relation("InspectionReviewer", fields: [reviewedById], references: [id])
  deletedBy           User?                 @relation("InspectionDeletedBy", fields: [deletedById], references: [id])
  parent              Inspection?           @relation("InspectionTree", fields: [parentInspectionId], references: [id])
  children            Inspection[]          @relation("InspectionTree")
  categories          InspectionCategory[]
  defects             Defect[]
  notifications       Notification[]
  permitChecks        InspectionPermitCheck[]
  mappingOverlays     DefectMappingOverlay[]
  photoRegister       PhotoRegisterEntry[]

  @@index([assetId, submittedAt])
  @@index([folderKey])
  @@index([parentInspectionId])
  @@index([reviewStatus, reviewRequestedFromId])
  @@index([deletedAt])
}

/// Persisted Client Export photo order + DoT register number (per inspection)
model PhotoRegisterEntry {
  id           String   @id @default(cuid())
  inspectionId String
  /// Stable key: defectphoto:{id} / form:{id} / defect:{id}:current|comparison
  photoKey     String
  takenAt      DateTime
  registerNo   Int
  sortOrder    Int
  path         String

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, photoKey])
  @@unique([inspectionId, registerNo])
  @@index([inspectionId, sortOrder])
}

/// Permit acknowledgements (shown on web report only — use no-print for PDF)
model InspectionPermitCheck {
  id              String  @id @default(cuid())
  inspectionId    String
  /// CONFINED_SPACE | TRAFFIC_MANAGEMENT | WORKING_AT_HEIGHTS
  permitKey       String
  label           String
  requiredOnAsset Boolean @default(true)
  /// true = will use / obtain; false = not needed (reason required)
  willUse         Boolean
  notNeededReason String?

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, permitKey])
  @@index([inspectionId])
}

model InspectionCategory {
  id           String  @id @default(cuid())
  inspectionId String
  category     String
  subcategory  String
  comments     String?

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

model Defect {
  id                   String   @id @default(cuid())
  defectCode           String
  inspectionId         String
  sortOrder            Int      @default(0)
  category             String?
  subcategory          String?
  componentId          String?
  groupName            String?
  groupNumber          String?
  componentNumber      String?
  wideningSide         String?
  wideningNumber       String?
  locationDetail       String?
  defectQty            Float?
  defectUnit           String?
  treatmentType        String?
  treatmentTimeframe   String?
  description          String
  comments             String?
  severity             String   @default("MEDIUM")
  photoPath            String?
  comparisonPhotoPath  String?
  carriedFromDefectId  String?
  taskTypeId           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  inspection Inspection      @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  taskType   DefectTaskType? @relation(fields: [taskTypeId], references: [id], onDelete: SetNull)
  photos     DefectPhoto[]

  @@unique([inspectionId, defectCode])
  @@index([inspectionId, sortOrder])
  @@index([componentId])
  @@index([taskTypeId])
}

model DefectPhoto {
  id        String    @id @default(cuid())
  defectId  String
  path      String
  caption   String?
  kind      String    @default("other")
  sortOrder Int       @default(0)
  /// Capture date (EXIF / file date) used for watermark + DoT YYMMDD
  takenAt   DateTime?
  createdAt DateTime  @default(now())

  defect Defect @relation(fields: [defectId], references: [id], onDelete: Cascade)

  @@index([defectId, sortOrder])
}

model DefectTaskType {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  defects Defect[]
}

model DefectMappingOverlay {
  id           String   @id @default(cuid())
  inspectionId String
  imagePath    String
  pinsJson     String   @default("[]")
  label        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

model AssetAttributeSnapshot {
  id        String   @id @default(cuid())
  assetId   String
  kind      String
  payload   String
  actorId   String?
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  actor User? @relation("SnapshotActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([assetId, kind, createdAt])
}

model Notification {
  id           String   @id @default(cuid())
  userId       String
  inspectionId String?
  title        String
  message      String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  inspection Inspection? @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
