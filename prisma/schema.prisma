// VenInspect — bridge, drainage & noise wall inspections

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  INSPECTOR
}

enum InspectionStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

/// How this inspection relates to others (combine / parent-child)
enum InspectionRelationKind {
  STANDALONE
  PARENT
  CHILD
}

enum AuditAssignmentStatus {
  PLANNED
  ASSIGNED
  IN_PROGRESS
  DONE
  CANCELLED
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  /// Login name (e.g. root). Optional — email also works for login.
  username        String?  @unique
  name            String
  role            Role     @default(INSPECTOR)
  passwordHash    String?
  microsoftOid    String?  @unique
  level1Qualified Boolean  @default(false)
  level2Qualified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inspectionsCreated  Inspection[]      @relation("InspectionCreator")
  inspectionsApproved Inspection[]      @relation("InspectionApprover")
  notifications       Notification[]
  documentsUploaded   AssetDocument[]   @relation("DocumentUploader")
  auditsAssigned      AuditAssignment[] @relation("AuditAssignee")
  auditsCreated       AuditAssignment[] @relation("AuditCreator")
}

model Asset {
  id                  String    @id @default(cuid())
  assetNumber         String    @unique
  assetVisionId       String?
  name                String
  /// Admin-managed catalogue code (e.g. BRIDGE, DRAINAGE, NOISE_WALL)
  type                String    @default("BRIDGE")
  /// Primary grouping key in registry & photo folders (e.g. Kororoit Creek Road)
  roadName            String    @default("Unknown Road")
  location            String?
  latitude            Float?
  longitude           Float?
  parentDirection     String?
  parentChainage      Float?
  parentAssetCode     String?
  parentAssetName     String?
  classification      String?
  notes               String?
  level1IntervalYears Int       @default(3)
  level2IntervalYears Int       @default(5)
  /// Manual baseline when history isn’t in VenInspect yet (bootstrap tracking)
  lastLevel1At        DateTime?
  lastLevel2At        DateTime?
  /// Site access / WHS flags — prompt on inspection start
  requireConfinedSpace      Boolean @default(false)
  requireTrafficManagement  Boolean @default(false)
  requireWorkingAtHeights   Boolean @default(false)
  /// Durable Asset Vision Attributes: { values, importedAt?, sourceFile? }
  profileJson         String?
  /// Structural components register: [{ id, name, category?, qty?, unit?, sortOrder }]
  componentsJson      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  inspections Inspection[]
  documents   AssetDocument[]
  assignments AuditAssignment[]

  @@index([roadName, assetNumber])
  @@index([assetVisionId])
  @@index([type])
}

model AssetDocument {
  id               String    @id @default(cuid())
  assetId          String
  title            String
  originalFilename String
  storagePath      String
  mimeType         String
  sizeBytes        Int
  /// JSON array of tag values from admin catalogue
  tagsJson         String    @default("[]")
  documentDate     DateTime?
  notes            String?
  uploadedById     String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  asset      Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([assetId])
}

model AuditAssignment {
  id            String                @id @default(cuid())
  assetId       String
  /// Inspection type code (LEVEL_1 / LEVEL_2 / …)
  level         String
  dueDate       DateTime
  assignedToId  String?
  createdById   String
  notes         String?
  status        AuditAssignmentStatus @default(PLANNED)
  inspectionId  String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  asset      Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("AuditAssignee", fields: [assignedToId], references: [id])
  createdBy  User  @relation("AuditCreator", fields: [createdById], references: [id])

  @@index([assignedToId, status, dueDate])
  @@index([assetId, dueDate])
  @@index([status, dueDate])
}

model Inspection {
  id                     String                 @id @default(cuid())
  assetId                String
  /// Inspection type code (e.g. LEVEL_1) — admin-editable list in settings
  level                  String
  status                 InspectionStatus       @default(DRAFT)
  inspectedAt            DateTime               @default(now())
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  /// Always set on create — used for same-day disambiguation & exports
  submittedAt            DateTime               @default(now())
  approvedAt             DateTime?
  generalComments        String?
  /// Template answers + UI state (open sections / optional pages) as JSON
  formPayload            String?
  createdById            String
  approvedById           String?
  requiresLevel2Approval Boolean                @default(false)

  /// Photo folder segment: DDMMYYYY or DDMMYYYY-HHmmss
  folderKey              String
  /// Display: "Kororoit Creek Road - SN1234 - 19072026" (+ time if needed)
  titleLabel             String
  relationKind           InspectionRelationKind @default(STANDALONE)
  parentInspectionId     String?

  asset         Asset                 @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy     User                  @relation("InspectionCreator", fields: [createdById], references: [id])
  approvedBy    User?                 @relation("InspectionApprover", fields: [approvedById], references: [id])
  parent        Inspection?           @relation("InspectionTree", fields: [parentInspectionId], references: [id])
  children      Inspection[]          @relation("InspectionTree")
  categories    InspectionCategory[]
  defects       Defect[]
  notifications Notification[]
  permitChecks  InspectionPermitCheck[]

  @@index([assetId, submittedAt])
  @@index([folderKey])
  @@index([parentInspectionId])
}

/// Permit acknowledgements (shown on web report only — use no-print for PDF)
model InspectionPermitCheck {
  id              String  @id @default(cuid())
  inspectionId    String
  /// CONFINED_SPACE | TRAFFIC_MANAGEMENT | WORKING_AT_HEIGHTS
  permitKey       String
  label           String
  requiredOnAsset Boolean @default(true)
  /// true = will use / obtain; false = not needed (reason required)
  willUse         Boolean
  notNeededReason String?

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, permitKey])
  @@index([inspectionId])
}

model InspectionCategory {
  id           String  @id @default(cuid())
  inspectionId String
  category     String
  subcategory  String
  comments     String?

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

model Defect {
  id                   String   @id @default(cuid())
  defectCode           String
  inspectionId         String
  category             String?
  subcategory          String?
  /// Stable id from asset componentsJson when tagged
  componentId          String?
  description          String
  comments             String?
  /// Customisable via admin settings (defaults: LOW/MEDIUM/HIGH/CRITICAL)
  severity             String   @default("MEDIUM")
  photoPath            String?
  /// Prior defect photo kept for side-by-side comparison when carried forward
  comparisonPhotoPath  String?
  carriedFromDefectId  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, defectCode])
  @@index([inspectionId])
  @@index([componentId])
}

model Notification {
  id           String   @id @default(cuid())
  userId       String
  inspectionId String?
  title        String
  message      String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  inspection Inspection? @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
