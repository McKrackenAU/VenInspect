[Unit]
Description=Watch for VenInspect update requests
After=network-online.target

[Path]
# Fires when update.request is created. Updater renames it immediately.
# No TriggerLimit — flock inside update.sh serializes concurrent starts.
PathExists=/var/lib/veninspect/update.request
Unit=veninspect-update.service

[Install]
WantedBy=multi-user.target
