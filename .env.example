# VenInspect local / LXC configuration
#
# DATA_DIR holds SQLite + compressed photos. On Proxmox, mount a dedicated
# disk or bind-mount here so the CT rootfs stays small.

DATA_DIR=./data
PORT=8181

# Signed login sessions (required in production — installer generates one)
SESSION_SECRET=dev-change-me

# Update channel for Admin → System (gitea | github)
# UPDATE_CHANNEL=gitea
# GITEA_RAW_BASE=http://192.168.13.9:3000/McKraken/VenInspect/raw/branch/main

# Google Maps (field map + nearby assets). Restrict key by HTTP referrer in Google Cloud.
# Used at runtime (passed from server) — no rebuild required when set in /etc/veninspect.env
# GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Set to 1 only when serving over HTTPS
# COOKIE_SECURE=1

# Optional: large disk for photos (Proxmox passthrough). Default = {DATA_DIR}/photos
# PHOTO_DIR=/mnt/veninspect-photos

# Optional override (defaults to file:{DATA_DIR}/veninspect.db — SQLite today)
# DATABASE_URL=file:./data/veninspect.db

# --- PostgreSQL (LXC installs a local instance; cutover later) ---
# See docs/POSTGRES-MIGRATION.md. Until cutover, leave DATABASE_URL unset/file.
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DB=veninspect
# POSTGRES_USER=veninspect
# POSTGRES_PASSWORD=
# DATABASE_URL_POSTGRES=postgresql://veninspect:PASSWORD@127.0.0.1:5432/veninspect
# After app cutover: DATABASE_URL=$DATABASE_URL_POSTGRES
